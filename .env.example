# Live Backend API & Base URLs
VITE_API_URL=https://api.jobuffer.com/api/v1
VITE_API_BASE_URL=https://api.jobuffer.com

# Live Frontend URL
VITE_FRONTEND_URL=https://jobuffer.com

# Jobbuffer Platform API Key (Optional override)
# VITE_PLATFORM_API_KEY=jb_live_...

# Stripe Configuration (Frontend only uses PUBLISHABLE key: pk_live_... or pk_test_...)
# NEVER put Stripe Secret API Keys in frontend code or .env files!
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
